[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude = 
    .git,
    __pycache__,
    docs/source/conf.py,
    old,
    build,
    dist,
    .eggs,
    *.egg,
    venv,
    .venv,
    migrations,
    .mypy_cache,
    .pytest_cache,
    .tox
per-file-ignores = 
    __init__.py:F401
    tests/*:F401,F811
max-complexity = 10
inline-quotes = double
# Compatibility with Black
# E203: whitespace before ':' (Black formats with spaces)
# W503: line break before binary operator (Black prefers this)